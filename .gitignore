target/
.direnv
**/*.rs.bk
.sisyphus/
.DS_Store
node_modules/

# Zephyr / west workspace artifacts (pulled by `west update`, never committed).
# examples/zephyr-os/ commits one shared west.yml plus each board's baseline app;
# users run `west init -l . && west update` to populate the workspace below.
.west/
build/
.venv/
# the manifest's `import: path-prefix: zephyr-os` nests the pulled trees under
# examples/zephyr-os/ instead of leaving them one level up in examples/ (west's
# T2 topdir is still examples/ — only the checkout paths are prefixed).
/examples/zephyr-os/zephyr-src/
/examples/zephyr-os/modules/

# FreeRTOS: the kernel is fetched by `make setup` (pinned tag), never committed.
examples/freertos/**/freertos-kernel/

# ThreadX: the kernel is fetched by `make setup` (pinned tag), never committed.
examples/threadx/**/threadx-kernel/
